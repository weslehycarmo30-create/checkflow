# Supabase (preencha localmente; nunca use a service_role no frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade com projetos que ainda usam a nomenclatura antiga.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comercial (somente dígitos do WhatsApp internacional; ex.: código do país + DDD + número).
# Sem esta variável, a landing exibe um estado explícito e não cria link de contato inválido.
NEXT_PUBLIC_CHECKFLOW_SALES_WHATSAPP=
